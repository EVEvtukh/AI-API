# Скопируйте этот файл как .env и подставьте свои ключи.
# В .env может лежать один ключ или все сразу — скрипты берут каждый свою переменную.

# Ключ OpenAI (platform.openai.com) — для openai_direct.py
OPENAI_API_KEY=sk-...

# Ключ ProxyAPI (proxyapi.ru) — для proxyapi_request.py
PROXYAPI_API_KEY=...

# Ключ GenAPI (gen-api.ru) — для genapi_request.py
GENAPI_API_KEY=...
